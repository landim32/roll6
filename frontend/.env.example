# Empty = same origin: the app calls /api and the Vite dev server (or nginx in Docker) proxies it.
VITE_API_URL=
# Where the Vite dev server forwards /api:
#   http://localhost:5119 → backend with `dotnet run` (Development)
#   http://localhost:5000 → API container of the homolog docker-compose
VITE_API_PROXY=http://localhost:5119
