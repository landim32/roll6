{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Roll6Context": "Host=localhost;Port=5432;Database=roll6_dev;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Secret": "<JWT_SECRET_MIN_64_CHARS>",
    "Issuer": "roll6-dev",
    "ExpirationHours": 24
  },
  "S3": {
    "BucketName": "roll6-dev",
    "Region": "us-east-1",
    "ServiceUrl": "https://nyc3.digitaloceanspaces.com",
    "ForcePathStyle": false,
    "Folder": "roll6",
    "UrlExpirationMinutes": 60
  }
}
