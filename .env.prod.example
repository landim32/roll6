# Production secrets (docker-compose-prod.yml). Only secrets live here;
# non-secret settings are in backend/Roll6.API/appsettings.Production.json and docker-compose-prod.yml.
# In CI this file is generated from GitHub Secrets/Variables by .github/workflows/deploy-prod.yml.

# Public domain of the site (Caddy issues its HTTPS certificate). In CI: GitHub variable ROLL6_DOMAIN.
ROLL6_DOMAIN=roll6.example.com

# Database — the host is the compose service "db".
ROLL6_CONNECTION_STRING=Host=db;Port=5432;Database=roll6;Username=roll6;Password=change-me
# Used by the db container to create the database. In CI they are read from ROLL6_CONNECTION_STRING;
# when running compose by hand, repeat the same values here.
POSTGRES_USER=roll6
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roll6

# JWT signing key (at least 32 characters)
ROLL6_JWT_SECRET=

# S3 (images) — DigitalOcean Spaces keys (DO > API > Spaces Keys).
# Endpoint, bucket and folder are in appsettings.Production.json / docker-compose-prod.yml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
