# Production secrets (docker-compose-prod.yml). Only secrets live here;
# non-secret settings are in backend/Roll6.API/appsettings.Production.json and docker-compose-prod.yml.
# In CI this file is generated from GitHub Secrets by .github/workflows/deploy-prod.yml.

# External PostgreSQL database
ROLL6_CONNECTION_STRING=Host=<db-host>;Port=5432;Database=roll6;Username=roll6;Password=change-me

# JWT signing key (at least 32 characters)
ROLL6_JWT_SECRET=

# S3 (images) — DigitalOcean Spaces keys (DO > API > Spaces Keys).
# Endpoint, bucket and folder are in appsettings.Production.json / docker-compose-prod.yml.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
