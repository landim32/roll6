# Production secrets (docker-compose-prod.yml). Only secrets live here;
# non-secret settings are in backend/SimpleTabletopMap.API/appsettings.Production.json.
# In CI this file is generated from GitHub Secrets by .github/workflows/deploy-prod.yml.

# Database
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=simple_tabletop_map
CONNECTION_STRING=Host=db;Port=5432;Database=simple_tabletop_map;Username=prod_user;Password=<STRONG_PASSWORD>

# JWT
JWT_SECRET=<STRONG_JWT_SECRET_MIN_64_CHARS>

# S3 (images) — DigitalOcean Spaces keys (DO > API > Spaces Keys).
# Endpoint and bucket are in appsettings.Production.json.
# Folder inside the bucket where uploads are stored
S3_FOLDER=simple-tabletop
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
