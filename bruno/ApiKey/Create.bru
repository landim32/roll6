meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/apikey
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno",
    "expiresAt": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("apiKeyId", res.body.apiKeyId);
    bru.setVar("apiKey", res.body.key);
  }
}

docs {
  The full key (`r6_…`) is returned only here.
}
