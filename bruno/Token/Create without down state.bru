meta {
  name: Create without down state
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/token
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Baú",
    "description": "Baú de madeira (só em pé)",
    "upSpace": 1,
    "downSpace": null,
    "upImage": "{{imageFileName}}",
    "downImage": null
  }
}

assert {
  res.status: eq 201
  res.body.downSpace: isNull
  res.body.downImage: isNull
}

docs {
  Without `downImage` and `downSpace` the token has no down state: both come back null.
}
