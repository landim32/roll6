meta {
  name: Create without down state
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/token
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Barril",
    "description": null,
    "upSpace": 1,
    "downSpace": null,
    "upImage": "{{imageFileName}}",
    "downImage": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("objectTokenId", res.body.tokenId);
  }
}
