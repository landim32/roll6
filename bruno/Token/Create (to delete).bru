meta {
  name: Create (to delete)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/token
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Token descartável",
    "description": null,
    "upSpace": null,
    "downSpace": null,
    "upImage": null,
    "downImage": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("tokenIdToDelete", res.body.tokenId);
  }
}
