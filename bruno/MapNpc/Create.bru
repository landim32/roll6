meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/mapnpc
  body: json
  auth: inherit
}

body:json {
  {
    "mapId": {{mapId}},
    "npcId": {{npcId}},
    "x": 12,
    "y": 6,
    "look": 3
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("mapNpcId", res.body.mapNpcId);
    bru.setVar("npcMapTokenId", res.body.mapTokenId);
  }
}
