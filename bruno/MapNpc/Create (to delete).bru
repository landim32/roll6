meta {
  name: Create (to delete)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/mapnpc
  body: json
  auth: inherit
}

body:json {
  {
    "mapId": {{mapId}},
    "npcId": {{npcId}},
    "x": 13,
    "y": 8,
    "look": 3
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("tempMapNpcId", res.body.mapNpcId);
  }
}
