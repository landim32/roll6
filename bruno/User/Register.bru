meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user
  body: json
  auth: none
}

body:json {
  {
    "name": "Rodrigo",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("created, or already registered on a previous run", () => {
    expect([201, 409]).to.include(res.status);
  });
}

docs {
  Creates the main user. On later runs the e-mail already exists (409), which is fine.
}
