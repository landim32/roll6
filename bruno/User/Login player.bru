meta {
  name: Login player
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/user/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{playerEmail}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("playerToken", res.body.token);
  }
}
