meta {
  name: Change password back
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/user/password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "{{newPassword}}",
    "newPassword": "{{password}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Restores the original password so the collection can run again.
}
