meta {
  name: Add to campaign
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/campaignnpc
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{campaignId}},
    "npcId": {{npcId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("campaignNpcId", res.body.campaignNpcId);
  }
}
