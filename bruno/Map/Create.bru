meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/map
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{campaignId}},
    "mapModelId": {{mapModelId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("mapId", res.body.mapId);
  }
}

docs {
  Name is generated as "<map model name> <n>" (e.g. "Masmorra 1").
}
