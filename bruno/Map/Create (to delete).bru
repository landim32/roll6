meta {
  name: Create (to delete)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/map
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{campaignId}},
    "mapModelId": {{mapModelId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("mapIdToDelete", res.body.mapId);
  }
}
