meta {
  name: Player requests access
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/campaigncharacter/request
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {
    "campaignId": {{campaignId}},
    "characterId": {{secondCharacterId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("requestId", res.body.campaignCharacterId);
  }
}
