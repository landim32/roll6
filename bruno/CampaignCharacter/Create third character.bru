meta {
  name: Create third character
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/character
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Gorim",
    "sheet": null,
    "life": 30,
    "energy": 5,
    "status": null,
    "move": 5,
    "image": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("thirdCharacterId", res.body.characterId);
  }
}
