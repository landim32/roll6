meta {
  name: Invite (after denial)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/campaigncharacter/invite
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{campaignId}},
    "characterId": {{thirdCharacterId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("declineId", res.body.campaignCharacterId);
  }
}
