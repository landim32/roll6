meta {
  name: Invite (after denial)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/campaigncharacter/invite
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{closedCampaignId}},
    "characterId": {{secondCharacterId}}
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 1
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("inviteId", res.body.campaignCharacterId);
  }
}

docs {
  Only the master (who may invite their own characters). Denied → Invited; pending request → Approved.
}
