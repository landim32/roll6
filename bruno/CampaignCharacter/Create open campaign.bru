meta {
  name: Create open campaign
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/campaign
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Mesa aberta",
    "open": true
  }
}

assert {
  res.status: eq 201
  res.body.open: eq true
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("openCampaignId", res.body.campaignId);
  }
}
