meta {
  name: Create closed campaign
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/campaign
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Mesa fechada",
    "open": false
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("closedCampaignId", res.body.campaignId);
  }
}
