meta {
  name: Request access (to deny)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/campaigncharacter/request
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{closedCampaignId}},
    "characterId": {{secondCharacterId}}
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 2
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("deniedId", res.body.campaignCharacterId);
  }
}
