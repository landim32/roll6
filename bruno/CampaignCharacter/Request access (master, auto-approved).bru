meta {
  name: Request access (master, auto-approved)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/campaigncharacter/request
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{campaignId}},
    "characterId": {{characterId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("campaignCharacterId", res.body.campaignCharacterId);
  }
}

docs {
  The master's own requests are approved directly.
}
