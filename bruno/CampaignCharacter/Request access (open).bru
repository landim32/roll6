meta {
  name: Request access (open)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/campaigncharacter/request
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{openCampaignId}},
    "characterId": {{characterId}}
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 3
}

docs {
  Open campaign → approved right away. status: 1 Invited, 2 RequestedAccess, 3 Approved, 4 Denied.
}
