meta {
  name: Request access (closed)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/campaigncharacter/request
  body: json
  auth: inherit
}

body:json {
  {
    "campaignId": {{closedCampaignId}},
    "characterId": {{characterId}}
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 2
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("requestId", res.body.campaignCharacterId);
  }
}

docs {
  Closed campaign → pending until the master decides.
}
