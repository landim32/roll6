meta {
  name: Create second character
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/character
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Elara",
    "sheet": null,
    "life": 18,
    "energy": 12,
    "status": null,
    "move": 6,
    "image": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("secondCharacterId", res.body.characterId);
  }
}
