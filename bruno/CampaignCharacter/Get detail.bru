meta {
  name: Get detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/campaigncharacter/{{campaignCharacterId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Owner, master or approved participant. sheet/sheetFile/sheetFileUrl/sheetFileType are this campaign's copy (032);
  characterSheet is the character's own sheet, read-only here.
}
