meta {
  name: Update
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/mapmodel/{{mapModelId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Taverna",
    "description": "Mapa da taverna",
    "image": "{{imageFileName}}",
    "gridWidth": 20,
    "gridHeight": 15,
    "imageWidth": 1600,
    "imageHeight": 1200,
    "imageTop": -20,
    "imageLeft": -40
  }
}

assert {
  res.status: eq 200
}
