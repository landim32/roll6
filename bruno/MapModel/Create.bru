meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/mapmodel
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Masmorra",
    "description": "Masmorra úmida com três salas",
    "image": "{{imageFileName}}",
    "gridWidth": 10,
    "gridHeight": 8,
    "imageWidth": 1600,
    "imageHeight": 1400,
    "imageTop": 0,
    "imageLeft": 0
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("mapModelId", res.body.mapModelId);
  }
}
