meta {
  name: Create (to delete)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/mapmodel
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Temporário",
    "description": "Mapa da taverna",
    "image": "{{imageFileName}}",
    "gridWidth": 20,
    "gridHeight": 15,
    "imageWidth": 1600,
    "imageHeight": 1200,
    "imageTop": 0,
    "imageLeft": 0
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("tempMapModelId", res.body.mapModelId);
  }
}
