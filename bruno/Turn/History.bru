meta {
  name: History
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/campaign/{{campaignId}}/turn/history?limit=2
  body: none
  auth: inherit
}

params:query {
  limit: 2
}

assert {
  res.status: eq 200
}

docs {
  Finished turns, newest first (028: turn console). Pass `nextBefore` as `before` to load older ones; null = turn 1.
}
