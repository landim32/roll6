meta {
  name: Upload
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/image
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(assets/sample.png)
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("imageFileName", res.body.fileName);
  }
}

docs {
  PNG, JPEG or WebP up to 10 MB. Use the returned `fileName` in image fields.
}
