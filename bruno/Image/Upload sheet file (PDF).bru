meta {
  name: Upload sheet file (PDF)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/document
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(assets/sample.pdf)
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("sheetFileName", res.body.fileName);
  }
}

docs {
  Character sheet file (022): PNG, JPEG, WebP or PDF up to 10 MB, stored exactly as sent. `type` = image | pdf.
}
