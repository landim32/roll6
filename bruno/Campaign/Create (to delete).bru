meta {
  name: Create (to delete)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/campaign
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Campanha descartável"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("campaignIdToDelete", res.body.campaignId);
  }
}
