meta {
  name: Create (to delete)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/campaign
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Temporária",
    "open": true
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("tempCampaignId", res.body.campaignId);
  }
}
