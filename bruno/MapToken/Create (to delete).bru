meta {
  name: Create (to delete)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/maptoken
  body: json
  auth: inherit
}

body:json {
  {
    "mapId": {{mapId}},
    "tokenId": {{tokenId}},
    "name": "Baú",
    "tokenType": 4,
    "sheet": null,
    "life": 0,
    "energy": 0,
    "status": null,
    "move": 0,
    "x": 1,
    "y": 0,
    "look": 0
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("mapTokenIdToDelete", res.body.mapTokenId);
  }
}
