meta {
  name: Update
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/character/{{characterId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Thorin",
    "sheet": "## Thorin\n- Anão guerreiro\n- Nível 3",
    "life": 30,
    "energy": 10,
    "move": 5,
    "image": "{{imageFileName}}",
    "tokenId": {{tokenId}},
    "sheetFile": "{{sheetFileName}}"
  }
}

assert {
  res.status: eq 200
}

docs {
  Replaces every field: omitting `image`, `tokenId` or `sheetFile` removes them.
}
