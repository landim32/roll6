meta {
  name: Create (to delete)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/character
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Temporário",
    "sheet": "## Thorin\n- Anão guerreiro\n- Nível 3",
    "life": 28,
    "energy": 10,
    "move": 5,
    "image": "{{imageFileName}}",
    "tokenId": {{tokenId}},
    "sheetFile": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("tempCharacterId", res.body.characterId);
  }
}
