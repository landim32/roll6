meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/character
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Thorin",
    "sheet": "## Thorin\n- Anão guerreiro\n- Nível 3",
    "life": 28,
    "energy": 10,
    "status": null,
    "move": 5,
    "image": "{{imageFileName}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar("characterId", res.body.characterId);
  }
}
