# Homolog environment (docker-compose.yml, ASPNETCORE_ENVIRONMENT=Docker)
# Copy to .env and fill in the values. Never commit .env.

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=roll6
CONNECTION_STRING=Host=db;Port=5432;Database=roll6;Username=postgres;Password=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_ISSUER=roll6-homolog

# S3 (images) — DigitalOcean Spaces. The Spaces region goes in the URL;
# S3_REGION stays us-east-1 (signing region). Keys come from DO > API > Spaces Keys.
S3_BUCKET_NAME=emagine
S3_REGION=us-east-1
S3_SERVICE_URL=https://nyc3.digitaloceanspaces.com
# Folder inside the bucket where uploads are stored
S3_FOLDER=roll6
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Ports exposed on the host
APP_PORT=5000
WEB_PORT=8080
DB_PORT=5432
