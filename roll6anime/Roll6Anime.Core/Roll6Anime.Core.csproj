<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The animation format validator is the backend's own file (062, research R4): linked, never copied, so the format
    keeps three implementations (server, site, criar-animacao skill) and the roll6anime gives the same answers.
  -->
  <ItemGroup>
    <Compile Include="..\..\backend\Roll6.Domain\Animations\AnimationFormat.cs" Link="Linked\AnimationFormat.cs" />
    <Compile Include="..\..\backend\Roll6.Domain\Enums\AnimationType.cs" Link="Linked\AnimationType.cs" />
    <Compile Include="..\..\backend\Roll6.Domain\Exceptions\DomainValidationException.cs" Link="Linked\DomainValidationException.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

</Project>
