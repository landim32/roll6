<Window x:Class="Roll6Anime.UploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar ao Roll6" Width="520" SizeToContent="Height"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <!-- One type, drawn like the window's buttons; the chosen one is green. -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="Target" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="Nome" Style="{StaticResource Heading}" />
        <TextBox x:Name="NameBox" Margin="0,4,0,12" MaxLength="100" AutomationProperties.Name="Nome da animação"
                 TextChanged="OnChanged" />
        <TextBlock Text="Tipo" Style="{StaticResource Heading}" />
        <WrapPanel x:Name="Types" Margin="0,4,0,4" AutomationProperties.Name="Tipo da animação" />
        <TextBlock Text="Os tokens usam por enquanto Parado, Andando e Derrotado." Foreground="{StaticResource Muted}"
                   FontSize="11" Margin="0,0,0,12" />
        <TextBlock x:Name="Problem" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,6,0" />
            <Button x:Name="SendButton" Content="Enviar" IsDefault="True" Style="{StaticResource Primary}" Click="OnSend" />
        </StackPanel>
    </StackPanel>
</Window>
