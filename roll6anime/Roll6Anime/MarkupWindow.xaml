<Window x:Class="Roll6Anime.MarkupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marcar print" MinWidth="560" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- One choice of the tool group, drawn like the window's buttons; the chosen one is green. -->
        <Style x:Key="Tool" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Tools and corrections -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="Desfazer" Click="OnUndo" Margin="0,0,6,0" ToolTip="Desfaz a última marcação (Ctrl+Z)" />
                <Button x:Name="ClearButton" Content="Limpar" Click="OnClear" ToolTip="Apaga todas as marcações (Desfazer traz de volta)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Ferramentas">
                <RadioButton x:Name="PencilTool" Style="{StaticResource Tool}" GroupName="Tools" IsChecked="True" Checked="OnTool"
                             Content="Lápis" AutomationProperties.Name="Lápis" ToolTip="Traço livre (1)" />
                <RadioButton x:Name="RectangleTool" Style="{StaticResource Tool}" GroupName="Tools" Checked="OnTool"
                             Content="Retângulo" AutomationProperties.Name="Retângulo" ToolTip="Retângulo pontilhado (2)" />
                <RadioButton x:Name="EllipseTool" Style="{StaticResource Tool}" GroupName="Tools" Checked="OnTool"
                             Content="Circunferência" AutomationProperties.Name="Circunferência" ToolTip="Circunferência pontilhada (3)" />
                <RadioButton x:Name="ArrowTool" Style="{StaticResource Tool}" GroupName="Tools" Checked="OnTool"
                             Content="Seta" AutomationProperties.Name="Seta" ToolTip="Seta, com a ponta onde o arrasto termina (4)" />
            </StackPanel>
        </DockPanel>

        <!-- Finish -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Concluir" Click="OnDone" IsDefault="True" Style="{StaticResource Primary}"
                    Margin="6,0,0,0" ToolTip="Anexa o print com as marcações (Enter)" />
            <Button DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" ToolTip="Fecha sem anexar (Esc)" />
            <TextBlock Text="Marque em vermelho o que o Claude deve olhar. Sem marcações, Concluir anexa o print como está."
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <!-- The print, in its own pixels, scaled to the window -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="6">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Grid x:Name="Stage" />
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
