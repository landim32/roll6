<Window x:Class="Roll6Anime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:claude="clr-namespace:Roll6Anime.Core.Claude;assembly=Roll6Anime.Core"
        xmlns:markup="clr-namespace:Roll6Anime.Core.Markup;assembly=Roll6Anime.Core"
        Title="roll6anime" Height="820" Width="1440" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="400" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Model and animations (US1) -->
        <DockPanel Grid.Column="0" Background="{StaticResource Surface}">
            <StackPanel DockPanel.Dock="Top" Margin="12">
                <TextBlock Text="Modelo" Style="{StaticResource Heading}" />
                <Button Content="Abrir modelo…" Click="OnOpenModel" Margin="0,6,0,6" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding ModelName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelPath}" />
                <TextBlock Text="Animações" Style="{StaticResource Heading}" Margin="0,16,0,2" />
                <TextBlock Text="{Binding AnimationsFolder}" Foreground="{StaticResource Muted}" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AnimationsFolder}" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Nova animação" Click="OnNewAnimation" Margin="12,6,12,12"
                    ToolTip="Nenhuma animação aberta: o próximo pedido ao Claude cria um arquivo novo" />
            <Button DockPanel.Dock="Bottom" Content="Enviar ao Roll6" Click="OnUpload" Margin="12,12,12,0"
                    IsEnabled="{Binding CanUpload}" ToolTip="{Binding UploadHint}" ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="Enviar ao Roll6" />
            <ListBox ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}" Margin="8,0,8,0"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Animações da pasta">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Text="inválido" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="SemiBold"
                                       ToolTip="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource VisibleWhenSet}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

        <!-- 3D view and time bar (US1) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Border Background="{StaticResource WarningBg}" Padding="10,6"
                        Visibility="{Binding ModelWarning, Converter={StaticResource VisibleWhenSet}}">
                    <TextBlock Text="{Binding ModelWarning}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource DangerBg}" Padding="10,6"
                        Visibility="{Binding SelectedError, Converter={StaticResource VisibleWhenSet}}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Arquivo inválido — " FontWeight="SemiBold" /><Run Text="{Binding SelectedError, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <wv2:WebView2 x:Name="Viewer" Grid.Row="1" DefaultBackgroundColor="#0B1220" />
            <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="10,4" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Visibility="{Binding Status, Converter={StaticResource VisibleWhenSet}}" />
        </Grid>

        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

        <!-- Conversation with the local Claude (US2) -->
        <DockPanel Grid.Column="4" Background="{StaticResource Surface}">
            <DockPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                <Button DockPanel.Dock="Right" Content="Nova conversa" Click="OnNewConversation"
                        IsEnabled="{Binding CanEditPrompt}" ToolTip="Recomeça a conversa desta animação" />
                <TextBlock Text="{Binding ConversationTitle}" Style="{StaticResource Heading}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="12">
                <!-- Prints of the 3D view that go with the next request -->
                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6"
                              Visibility="{Binding HasAttachments, Converter={StaticResource VisibleWhenTrue}}"
                              AutomationProperties.Name="Prints anexados">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type markup:PrintAttachment}">
                            <Grid Margin="0,0,6,6" ToolTip="{Binding Caption}">
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Background="{StaticResource Bg}"
                                        Cursor="Hand" MouseLeftButtonUp="OnOpenAttachment"
                                        AutomationProperties.Name="Marcar este print">
                                    <Image Source="{Binding Png, Converter={StaticResource PngImage}}" Height="72" Stretch="Uniform" />
                                </Border>
                                <Button Content="×" Click="OnRemoveAttachment" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="2" Padding="6,0" ToolTip="Remover este print" AutomationProperties.Name="Remover print"
                                        IsEnabled="{Binding DataContext.CanEditPrompt, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="PromptBox" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Height="84"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding CanEditPrompt}" PreviewKeyDown="OnPromptKey"
                         AutomationProperties.Name="Pedido ao Claude" ToolTip="Enter envia, Shift+Enter quebra a linha" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Enviar" Click="OnSend" IsEnabled="{Binding CanSend}"
                            Style="{StaticResource Primary}" Margin="6,0,0,0" ToolTip="{Binding SendBlockedReason}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button DockPanel.Dock="Right" Content="Parar" Click="OnStop"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button DockPanel.Dock="Left" Content="Anexar print" Click="OnCapture" IsEnabled="{Binding CanCapture}" Margin="0,0,6,0"
                            ToolTip="Anexa ao pedido uma imagem da vista 3D como está agora: a pose deste instante, vista desta câmera"
                            ToolTipService.ShowOnDisabled="True" />
                    <TextBlock Text="O Claude está trabalhando…" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}" />
                </DockPanel>
            </StackPanel>
            <ScrollViewer x:Name="MessagesScroll" Margin="12,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Conversation.Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type claude:ConversationMessage}">
                            <Border x:Name="Bubble" Margin="0,4" Padding="10,6" CornerRadius="8" Background="{StaticResource Surface2}"
                                    HorizontalAlignment="Left" MaxWidth="360">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Images}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Converter={StaticResource PngImage}}" Height="96" Stretch="Uniform"
                                                       Margin="0,0,6,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" Padding="0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="{x:Static claude:ConversationRole.User}">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AccentSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="{x:Static claude:ConversationRole.Notice}">
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Bubble" Property="Padding" Value="2,0" />
                                    <Setter TargetName="Body" Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                                    <Setter TargetName="Body" Property="FontSize" Value="12" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
