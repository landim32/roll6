# The production domain comes from ROLL6_DOMAIN (GitHub variable → .env.prod → caddy container). Its DNS must
# point to the server before the first deploy so Caddy can issue the Let's Encrypt certificate.
# The web container serves the SPA and proxies /api, /hubs and /mcp to the API container.
{$ROLL6_DOMAIN} {
    encode gzip
    reverse_proxy web:80
}
